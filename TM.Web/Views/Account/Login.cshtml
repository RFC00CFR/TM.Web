@model TM.Web.Models.AccountModel

@{
    ViewData["Title"] = "Login";
}

<div>
    <section class="vh-100 gradient-custom">
        <div class="container py-5 h-100">
            <div class="row d-flex justify-content-center align-items-center h-100">
                <div class="col-12 col-md-8 col-lg-6 col-xl-5">
                    <div class="card bg-dark text-white" style="border-radius: 1rem;">
                        <div class="card-body p-5 text-center">
                            <h2 class="fw-bold mb-2 text-uppercase">Logueo</h2>
                            <p class="text-white-50 mb-5">Ingresa tu nombre y apellido!</p>

                            <form asp-action="Login" method="post" novalidate>
                                <div class="form-outline form-white mb-4">
                                    <label class="form-label" asp-for="Nombre"></label>
                                    <input class="form-control form-control-lg" asp-for="Nombre" />
                                    <span class="text-danger" asp-validation-for="Nombre"></span>
                                </div>

                                <div class="form-outline form-white mb-4">
                                    <label class="form-label" asp-for="Apellido"></label>
                                    <input class="form-control form-control-lg" asp-for="Apellido" />
                                    <span class="text-danger" asp-validation-for="Apellido"></span>
                                </div>

                                <button class="btn btn-outline-light btn-lg px-5" type="submit">Ingresar</button>
                            </form>

                            <div class="mt-3">
                                <span class="text-danger" asp-validation-summary="All"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <!-- Scripts de validación necesarios -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js" integrity="sha512-..." crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation/1.19.3/jquery.validate.min.js" integrity="sha512-..." crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js" integrity="sha512-..." crossorigin="anonymous"></script>
}
