@model TM.Arquitecture.Models.Ticket

@{
    ViewData["Title"] = "Ticket Details";
}

<h1>@ViewData["Title"]</h1>

<div>
    <h4>Ticket</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Id)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Id)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Descripcion)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Descripcion)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Prioridad)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Prioridad)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.FechaDeAsignado)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FechaDeAsignado)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.FechaDeEntrega)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FechaDeEntrega)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Estado)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Estado)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.AsignadoPor)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.AsignadoPorNavigation.Nombre)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.AsignadoA)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.AsignadoANavigation.Nombre)
        </dd>
    </dl>

    <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-warning">Edit</a>
    <a href="@Url.Action("Index")" class="btn btn-primary">Back to List</a>
    <a href="@Url.Action("Finalizar", "Ticket", new { id = Model.Id })" class="btn btn-success">Finalizar Ticket</a>

</div>
