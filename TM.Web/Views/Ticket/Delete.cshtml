@model TM.Arquitecture.Models.Ticket

@{
    ViewData["Title"] = "Delete Ticket";
}

<h1>@ViewData["Title"]</h1>

<h4>Are you sure you want to delete this?</h4>
<hr />
<div>
    <h4>Ticket</h4>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Id)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Id)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Descripcion)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Descripcion)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Prioridad)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Prioridad)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.FechaDeAsignado)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FechaDeAsignado.ToString("d"))
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.FechaDeEntrega)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FechaDeEntrega.ToString("d"))
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Estado)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Estado)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.AsignadoPor)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.AsignadoPorNavigation.Nombre)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.AsignadoA)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.AsignadoANavigation.Nombre)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a href="@Url.Action("Index")" class="btn btn-secondary">Back to List</a>
    </form>
</div>
