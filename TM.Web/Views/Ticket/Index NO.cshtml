@model IEnumerable<TM.Arquitecture.Models.Ticket>

@{
    ViewData["Title"] = "Tickets";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a href="@Url.Action("Create")" class="btn btn-primary">Create New Ticket</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.First().Id)</th>
            <th>@Html.DisplayNameFor(model => model.First().Descripcion)</th>
            <th>@Html.DisplayNameFor(model => model.First().Prioridad)</th>
            <th>@Html.DisplayNameFor(model => model.First().FechaDeAsignado)</th>
            <th>@Html.DisplayNameFor(model => model.First().FechaDeEntrega)</th>
            <th>@Html.DisplayNameFor(model => model.First().Estado)</th>
            <th>@Html.DisplayNameFor(model => model.First().AsignadoPorNavigation.Nombre)</th>
            <th>@Html.DisplayNameFor(model => model.First().AsignadoANavigation.Nombre)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Descripcion</td>
                <td>@item.Prioridad</td>
                <td>@item.FechaDeAsignado.ToString("d")</td>
                <td>@item.FechaDeEntrega.ToString("d")</td>
                <td>@item.Estado</td>
                <td>@item.AsignadoPorNavigation.Nombre</td>
                <td>@item.AsignadoANavigation.Nombre</td>
                <td>
                    <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-info">Details</a>
                    <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-warning">Edit</a>
                    <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
