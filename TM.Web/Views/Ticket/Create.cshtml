@model TM.Arquitecture.Models.Ticket

@{
    ViewData["Title"] = "Create Ticket";
}

<h1>@ViewData["Title"]</h1>

<h4>Ticket</h4>
<hr />
 

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="Descripcion" class="control-label"></label>
        <input asp-for="Descripcion" class="form-control" required/>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Prioridad" class="control-label"></label>
        <select asp-for="Prioridad" class="form-control" required>
            <option value="Alto">Alto</option>
            <option value="Medio">Medio</option>
            <option value="Bajo">Bajo</option>
        </select>
        <span asp-validation-for="Prioridad" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="FechaDeAsignado" class="control-label"></label>
        <input asp-for="FechaDeAsignado" class="form-control" type="date" required/>
        <span asp-validation-for="FechaDeAsignado" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="FechaDeEntrega" class="control-label"></label>
        <input asp-for="FechaDeEntrega" class="form-control" type="date" required />
        <span asp-validation-for="FechaDeEntrega" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Estado" class="control-label"></label>
        <select asp-for="Estado" class="form-control" required>
            <option value="Cancelado">Cancelado</option>
            <option value="Asignado">Asignado</option>
            <option value="Aprobado">Aprobado</option>
            <option value="Revision">Revisión</option>
        </select>
        <span asp-validation-for="Estado" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="AsignadoPor" class="control-label"></label>
        <select asp-for="AsignadoPor" class="form-control" asp-items="ViewBag.AsignadoPor" required></select>
        <span asp-validation-for="AsignadoPor" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="AsignadoA" class="control-label"></label>
        <select asp-for="AsignadoA" class="form-control" asp-items="ViewBag.AsignadoA" required></select>
        <span asp-validation-for="AsignadoA" class="text-danger"></span>
    </div>
    <div class="form-group">
        <input type="submit" value="Create" class="btn btn-primary" />
    </div>
</form>
<a href="@Url.Action("Index")" class="btn btn-secondary">Back to List</a>
