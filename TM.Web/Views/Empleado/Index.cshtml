@model IEnumerable<TM.Arquitecture.Models.Empleado>

<h2>Empleados</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Crear Nuevo Empleado</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Puesto</th>
            <th>Departamento</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var empleado in Model)
        {
            <tr>
                <td>@empleado.Nombre</td>
                <td>@empleado.Apellido</td>
                <td>@empleado.Puesto</td>
                <td>@empleado.Departamento</td>
                <td>
                    <a asp-action="Details" asp-route-id="@empleado.Id" class="btn btn-info">Detalles</a>
                    <a asp-action="Edit" asp-route-id="@empleado.Id" class="btn btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@empleado.Id" class="btn btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
